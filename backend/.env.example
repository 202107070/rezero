NODE_ENV=development
HOST=0.0.0.0
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rezero
DB_PASSWORD=change-me
DB_NAME=rezero
DB_CONNECTION_LIMIT=5

# Valkey는 Redis 규격을 지원하므로 환경변수 이름은 REDIS로 통일합니다.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# ChatGPT(OpenAI) — AI 사용자 분석에 사용합니다. 키를 발급받아 아래에 넣어주세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NODE_ENV=development
HOST=0.0.0.0
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rezero
DB_PASSWORD=change-me
DB_NAME=rezero
DB_CONNECTION_LIMIT=5

# Valkey는 Redis 규격을 지원하므로 환경변수 이름은 REDIS로 통일합니다.
# 로컬 직접 실행: 127.0.0.1
# docker/podman compose: game-server 가 REDIS_HOST=redis 로 덮어씁니다.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

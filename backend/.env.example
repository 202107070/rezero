NODE_ENV=development
HOST=0.0.0.0
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rezero
DB_PASSWORD=change-me
DB_NAME=rezero
DB_CONNECTION_LIMIT=5

# Valkey는 Redis 규격을 지원하므로 환경변수 이름은 REDIS로 통일합니다.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 기존 채팅을 보존할 운영 배포에서만 true로 설정합니다.
PRESERVE_CHAT_ON_START=true

JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# rootless Podman 코드 실행기. 저장소 루트에서 전용 이미지를 먼저 빌드한다.
RUNNER_BINARY=podman
RUNNER_IMAGE=localhost/rezero-runner:1
# RUNNER_TEMP_DIR=/별도/임시/경로

# Cursor AI — AI 사용자 분석에 사용합니다. Cursor Dashboard → API Keys 에서 발급하세요.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

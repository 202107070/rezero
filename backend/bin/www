#!/usr/bin/env node

import http from "node:http";

import app from "../app.js";
import { env } from "#config/envConfig.js";
import { pool, testDbConnection } from "#config/dbConfig.js";
import { redisClient, connectRedis } from "#config/redisConfig.js";
import { getSocket, initSocket } from "#config/socketConfig.js";

const server = http.createServer(app);

initSocket(server);

let shuttingDown = false;

function logShutdown(step, detail) {
  const suffix = detail ? " — " + detail : "";
  console.log("[shutdown] " + step + suffix);
}

async function startServer() {
  await testDbConnection();
  await connectRedis();

  server.listen(env.port, env.host, function () {
    console.log("Backend running on http://" + env.host + ":" + env.port);
  });
}

function forceExit(code) {
  console.error("[shutdown] Force exit (code=" + code + "). 프로세스를 강제 종료합니다.");
  process.exit(code);
}

async function stopServer(signal) {
  if (shuttingDown) {
    logShutdown("already-in-progress", signal + " ignored");
    return;
  }
  shuttingDown = true;
  logShutdown("start", signal + " received");

  // unref 하지 않음 — 열린 핸들이 있어도 강제 종료 타이머가 반드시 동작해야 함
  const forceTimer = setTimeout(function () {
    forceExit(1);
  }, 4000);

  try {
    const io = getSocket();
    if (io) {
      logShutdown("socketio", "disconnectSockets(true)");
      try {
        io.disconnectSockets(true);
      } catch (err) {
        console.error("[shutdown] disconnectSockets error:", err?.message || err);
      }
      logShutdown("socketio", "closing server (max 1.5s)");
      await Promise.race([
        new Promise(function (resolve) {
          io.close(function () {
            logShutdown("socketio", "closed");
            resolve();
          });
        }),
        new Promise(function (resolve) {
          setTimeout(function () {
            logShutdown("socketio", "close timeout — continue");
            resolve();
          }, 1500);
        }),
      ]);
    } else {
      logShutdown("socketio", "not initialized");
    }
  } catch (err) {
    console.error("[shutdown] Socket.IO close error:", err?.message || err);
  }

  if (typeof server.closeAllConnections === "function") {
    try {
      logShutdown("http", "closeAllConnections()");
      server.closeAllConnections();
    } catch (err) {
      console.error("[shutdown] closeAllConnections error:", err?.message || err);
    }
  }

  logShutdown("http", "server.close (max 1.5s)");
  await new Promise(function (resolve) {
    server.close(function () {
      logShutdown("http", "server closed");
      resolve();
    });
    setTimeout(function () {
      logShutdown("http", "server.close timeout — continue");
      resolve();
    }, 1500);
  });

  try {
    if (redisClient.isOpen) {
      logShutdown("redis", "quit (max 1s)");
      await Promise.race([
        redisClient.quit().then(function () {
          logShutdown("redis", "quit ok");
        }),
        new Promise(function (_, reject) {
          setTimeout(function () {
            reject(new Error("redis quit timeout"));
          }, 1000);
        }),
      ]);
    } else {
      logShutdown("redis", "already closed");
    }
  } catch (err) {
    console.error("[shutdown] Redis quit error:", err?.message || err);
    try {
      redisClient.disconnect();
      logShutdown("redis", "disconnect() fallback");
    } catch {
      // ignore
    }
  }

  try {
    logShutdown("db", "pool.end (max 1s)");
    await Promise.race([
      pool.end().then(function () {
        logShutdown("db", "pool ended");
      }),
      new Promise(function (_, reject) {
        setTimeout(function () {
          reject(new Error("pool end timeout"));
        }, 1000);
      }),
    ]);
  } catch (err) {
    console.error("[shutdown] DB pool end error:", err?.message || err);
  }

  clearTimeout(forceTimer);
  logShutdown("done", "process.exit(0)");
  process.exit(0);
}

server.on("error", function (error) {
  console.error("Backend server error:", error.message);
  process.exit(1);
});

process.once("SIGINT", function () {
  stopServer("SIGINT");
});

process.once("SIGTERM", function () {
  stopServer("SIGTERM");
});

// Windows Ctrl+Break
process.once("SIGBREAK", function () {
  stopServer("SIGBREAK");
});

startServer().catch(async function (error) {
  console.error("Backend startup failed:", error.message);
  try {
    if (redisClient.isOpen) {
      await redisClient.quit();
    }
  } catch {
    // ignore
  }
  try {
    await pool.end();
  } catch {
    // ignore
  }
  process.exit(1);
});

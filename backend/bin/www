#!/usr/bin/env node

import http from "node:http";

import app from "../app.js";
import { env } from "#config/envConfig.js";
import { pool, testDbConnection } from "#config/dbConfig.js";
import { redisClient, connectRedis } from "#config/redisConfig.js";
import { getSocket, initSocket } from "#config/socketConfig.js";

const server = http.createServer(app);

initSocket(server);

let shuttingDown = false;

async function startServer() {
  await testDbConnection();
  await connectRedis();

  server.listen(env.port, env.host, function () {
    console.log("Backend running on http://" + env.host + ":" + env.port);
  });
}

async function stopServer(signal) {
  if (shuttingDown) return;
  shuttingDown = true;
  console.log(signal + " received. Backend is shutting down.");

  const forceTimer = setTimeout(function () {
    console.error("Force exit after shutdown timeout.");
    process.exit(1);
  }, 5000);
  if (typeof forceTimer.unref === "function") forceTimer.unref();

  try {
    const io = getSocket();
    if (io) {
      await new Promise(function (resolve) {
        io.close(function () {
          resolve();
        });
      });
    }
  } catch (err) {
    console.error("Socket.IO close error:", err?.message || err);
  }

  server.close(async function () {
    try {
      if (redisClient.isOpen) {
        await redisClient.quit();
      }
    } catch (err) {
      console.error("Redis quit error:", err?.message || err);
    }
    try {
      await pool.end();
    } catch (err) {
      console.error("DB pool end error:", err?.message || err);
    }
    process.exit(0);
  });

  if (typeof server.closeAllConnections === "function") {
    setTimeout(function () {
      try {
        server.closeAllConnections();
      } catch {
        // ignore
      }
    }, 2000);
  }
}

server.on("error", function (error) {
  console.error("Backend server error:", error.message);
  process.exit(1);
});

process.once("SIGINT", function () {
  stopServer("SIGINT");
});

process.once("SIGTERM", function () {
  stopServer("SIGTERM");
});

startServer().catch(async function (error) {
  console.error("Backend startup failed:", error.message);
  if (redisClient.isOpen) {
    await redisClient.quit();
  }
  await pool.end();
  process.exit(1);
});

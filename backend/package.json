    "#docker/worker/*": "./src/infra/docker/worker/*",
    "#docker/test/*": "./src/infra/docker/test/*",
    "#constants/*": "./src/constants/*",
    "#sandbox/*": "../../../shared/fileShare/sandbox/",
    "#gameDocker/*": "./src/infra/docker/dockerimage/game.Dockerfile/*",

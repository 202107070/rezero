    "#model/*": "./src/model/*",
    "#utils/*": "./src/utils/*",
    "#service/*": "./src/service/*",
    "#handler/*": "./src/handler/*",
    "#dto/*": "./src/dto/*",
    "#docker/config/*": "./src/infra/docker/config/*",

{
  "name": "rezero",
"type":"module",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "main": "frontend/dist-electron/main.js",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 0.0.0.0 --port 5173",
    "electron:build": "tsc -p frontend/tsconfig.electron.json && node -e \"require('fs').copyFileSync('frontend/electron/preload.cjs','frontend/dist-electron/preload.cjs')\"",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:build && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts && npm run electron:build",
    "start": "electron .",
    "lint": "eslint frontend",
    "preview": "vite preview --config frontend/vite.config.ts",
    "backend": "node backend/bin/www",
    "backend:dev": "nodemon backend/bin/www"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "@uiw/react-codemirror": "^4.25.10",
    "connect-redis": "^9.0.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ejs": "~2.6.1",
    "express": "~4.16.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-errors": "~1.6.3",
    "ioredis": "^5.11.1",
    "is-podman": "^1.0.1",
    "mariadb": "^3.5.3",
    "morgan": "~1.9.1",
    "mysql2": "^3.22.5",
    "pino": "^10.3.1",
    "pm2": "^7.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "redis": "^6.0.0",
    "rimraf": "^6.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^8.0.0"
  }
}
